# Supabase credentials. Copy to .env and fill in with your project values.
# Found in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Render avatar pictograms as local SVG images instead of platform emoji.
# Set to "false" to fall back to lettered chips.
VITE_REPLACE_EMOJI=true
